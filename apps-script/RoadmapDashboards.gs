function setupSleekDashboards(){var ss=getJmhSpreadsheet_(),live=ss.getSheetByName("Live Operations")||ss.insertSheet("Live Operations"),crew=ss.getSheetByName("Crew Management")||ss.insertSheet("Crew Management"),reports=ss.getSheetByName("Management Reports")||ss.insertSheet("Management Reports"),payroll=ss.getSheetByName("Payroll"),jobs=ss.getSheetByName("Jobs"),employees=ss.getSheetByName("Employees");[live,crew,reports].forEach(function(s){s.clear();s.clearConditionalFormatRules();});var jobNames=jobs.getLastRow()<2?[]:jobs.getRange(2,2,jobs.getLastRow()-1,1).getDisplayValues().flat().filter(String),emap=rmHeaderMap(employees),ec=rmFindHeader(emap,["Employee","Employee Name","Name"]),employeeNames=employees.getLastRow()<2?[]:employees.getRange(2,ec,employees.getLastRow()-1,1).getDisplayValues().flat().filter(String);
// LIVE OPERATIONS
dashHeader(live,"JMH  |  LIVE OPERATIONS","Real-time crew status • synchronized with the manager portal",8);live.getRange("A4").setValue("WORK DATE").setFontWeight("bold");live.getRange("B4").setValue(rmDateOnly(new Date())).setNumberFormat("mmm d, yyyy").setBackground("#fff7ed");live.getRange("D4").setValue("STATUS FILTER").setFontWeight("bold");dashDropdown(live.getRange("E4"),["All","Clocked In","Clocked Out"]);live.getRange("G4").setValue("JOB FILTER").setFontWeight("bold");dashDropdown(live.getRange("H4"),["All"].concat(jobNames));dashSection(live,6,1,8,"TODAY’S CREW");live.getRange(7,1,1,8).setValues([["Employee","Status","Clock In","Current Job","Current Task","Assigned Job","Crew Leader","Daily Paid Hrs"]]).setBackground(DASH_COLORS.dark).setFontColor(DASH_COLORS.white).setFontWeight("bold");employeeNames.forEach(function(name,i){var r=i+8;live.getRange(r,1).setValue(name);live.getRange(r,2).setFormula('=IF(COUNTIFS(\'Time Log\'!$A:$A,$B$4,\'Time Log\'!$B:$B,A'+r+',\'Time Log\'!$E:$E,"")>0,"CLOCKED IN","CLOCKED OUT")');live.getRange(r,3).setFormula('=IFERROR(INDEX(FILTER(\'Time Log\'!$D:$D,\'Time Log\'!$A:$A=$B$4,\'Time Log\'!$B:$B=A'+r+',\'Time Log\'!$E:$E=""),1),"")');live.getRange(r,4).setFormula('=IFERROR(INDEX(FILTER(\'Time Log\'!$C:$C,\'Time Log\'!$A:$A=$B$4,\'Time Log\'!$B:$B=A'+r+',\'Time Log\'!$E:$E=""),1),"")');live.getRange(r,5).setFormula('=IFERROR(INDEX(FILTER(\'Task Log\'!$E:$E,\'Task Log\'!$A:$A=$B$4,\'Task Log\'!$B:$B=A'+r+',\'Task Log\'!$G:$G=""),1),"")');live.getRange(r,6).setFormula('=IFERROR(INDEX(FILTER(\'Crew Assignments\'!$C:$C,INT(\'Crew Assignments\'!$A:$A)=INT($B$4),\'Crew Assignments\'!$B:$B=A'+r+'),1),"UNASSIGNED")');live.getRange(r,7).setFormula('=IFERROR(INDEX(FILTER(\'Crew Assignments\'!$D:$D,INT(\'Crew Assignments\'!$A:$A)=INT($B$4),\'Crew Assignments\'!$B:$B=A'+r+'),1),"")');live.getRange(r,8).setFormula('=IFERROR(SUMIFS(\'Time Log\'!$H:$H,\'Time Log\'!$B:$B,A'+r+',\'Time Log\'!$A:$A,$B$4),0)');});live.getRange(8,3,employeeNames.length,1).setNumberFormat("h:mm AM/PM");live.getRange(8,8,employeeNames.length,1).setNumberFormat("0.00");live.setColumnWidths(1,8,120);live.setColumnWidth(1,170);live.setColumnWidth(5,190);live.getRange(7,1,Math.max(employeeNames.length+1,2),8).createFilter();var liveRules=[SpreadsheetApp.newConditionalFormatRule().whenTextEqualTo("CLOCKED IN").setBackground(DASH_COLORS.green).setFontColor("#166534").setRanges([live.getRange(8,2,Math.max(employeeNames.length,1),1)]).build(),SpreadsheetApp.newConditionalFormatRule().whenTextEqualTo("CLOCKED OUT").setBackground(DASH_COLORS.red).setFontColor("#991b1b").setRanges([live.getRange(8,2,Math.max(employeeNames.length,1),1)]).build(),SpreadsheetApp.newConditionalFormatRule().whenTextEqualTo("UNASSIGNED").setBackground(DASH_COLORS.gold).setRanges([live.getRange(8,6,Math.max(employeeNames.length,1),1)]).build()];live.setConditionalFormatRules(liveRules);
// CREW MANAGEMENT
dashHeader(crew,"JMH  |  CREW MANAGEMENT","Edit today’s assignments here or in the manager portal — both use the same data",7);crew.getRange("A4").setValue("ASSIGNMENT DATE").setFontWeight("bold");crew.getRange("B4").setValue(rmDateOnly(new Date())).setNumberFormat("mmm d, yyyy").setBackground("#fff7ed");crew.getRange("D4").setValue("VIEW JOB").setFontWeight("bold");dashDropdown(crew.getRange("E4"),["All"].concat(jobNames));crew.getRange("G4").setFormula('=HYPERLINK("https://script.google.com/macros/s/AKfycbwqzwDp_vGM9wO6HTadN12gzEUhnli1nvHeiL2NxC3CJPglZu2MGjBbtaghv-GBPid1cQ/exec?page=manager","OPEN MANAGER PORTAL ↗")').setBackground(DASH_COLORS.bronze).setFontColor(DASH_COLORS.white).setFontWeight("bold").setHorizontalAlignment("center");dashSection(crew,6,1,7,"DAILY ASSIGNMENTS — EDIT JOB, LEADER, STATUS, OR NOTES");crew.getRange(7,1,1,7).setValues([["Employee","Assigned Job","Crew Leader","Status","Source","Notes","Live Status"]]).setBackground(DASH_COLORS.dark).setFontColor(DASH_COLORS.white).setFontWeight("bold");employeeNames.forEach(function(name,i){var r=i+8;crew.getRange(r,1).setValue(name);dashDropdown(crew.getRange(r,2),[""].concat(jobNames));dashDropdown(crew.getRange(r,3),[""].concat(employeeNames));dashDropdown(crew.getRange(r,4),["Assigned","Off","Inactive"]);crew.getRange(r,7).setFormula('=IF(COUNTIFS(\'Time Log\'!$A:$A,$B$4,\'Time Log\'!$B:$B,A'+r+',\'Time Log\'!$E:$E,"")>0,"CLOCKED IN","CLOCKED OUT")');});crew.setColumnWidths(1,7,135);crew.setColumnWidth(1,175);crew.setColumnWidth(6,230);crew.setConditionalFormatRules([SpreadsheetApp.newConditionalFormatRule().whenTextEqualTo("CLOCKED IN").setBackground(DASH_COLORS.green).setRanges([crew.getRange(8,7,Math.max(employeeNames.length,1),1)]).build()]);
// MANAGEMENT REPORTS
dashHeader(reports,"JMH  |  MANAGEMENT REPORTS","Profitability • labor efficiency • drive and lunch visibility",9);reports.getRange("A4").setValue("JOB FILTER").setFontWeight("bold");dashDropdown(reports.getRange("B4"),["All"].concat(jobNames));reports.getRange("D4").setValue("REPORT PERIOD").setFontWeight("bold");dashDropdown(reports.getRange("E4"),["All Time","This Month","This Year"]);reports.getRange("G4").setFormula('=HYPERLINK("https://script.google.com/macros/s/AKfycbwqzwDp_vGM9wO6HTadN12gzEUhnli1nvHeiL2NxC3CJPglZu2MGjBbtaghv-GBPid1cQ/exec?page=manager","OPEN REPORT TOOLS ↗")').setBackground(DASH_COLORS.bronze).setFontColor(DASH_COLORS.white).setFontWeight("bold");dashSection(reports,6,1,9,"JOB PROFITABILITY SNAPSHOT");reports.getRange(7,1,1,9).setValues([["Job","Contract","Approved COs","Revenue","Paid Hours","Productive Hours","Labor Cost","Margin*","Updated"]]).setBackground(DASH_COLORS.dark).setFontColor(DASH_COLORS.white).setFontWeight("bold");var summary=refreshFinancialReportSheetInternal();if(summary.length)reports.getRange(8,1,summary.length,9).setValues(summary.map(function(x){return[x.job,x.contract,x.changeOrders,x.revenue,x.paidHours,x.productiveHours,x.laborCost,x.margin,new Date()];}));reports.getRange(8,2,Math.max(summary.length,1),3).setNumberFormat("$#,##0.00");reports.getRange(8,7,Math.max(summary.length,1),2).setNumberFormat("$#,##0.00");reports.getRange("A"+(summary.length+10)).setValue("*Margin shown before materials, equipment, overhead, and other non-labor costs.").setFontStyle("italic").setFontColor("#6b7280");reports.setColumnWidths(1,9,125);reports.setColumnWidth(1,180);if(summary.length){var chart=reports.newChart().setChartType(Charts.ChartType.COLUMN).addRange(reports.getRange(7,1,summary.length+1,1)).addRange(reports.getRange(7,7,summary.length+1,2)).setPosition(8,11,0,0).setOption("title","Labor Cost vs. Margin by Job").setOption("colors",[DASH_COLORS.bronze,DASH_COLORS.brown]).build();reports.insertChart(chart);}
// PAYROLL BRANDING
if(payroll){payroll.setHiddenGridlines(true);payroll.getRange("A1:E1").setBackground(DASH_COLORS.brown).setFontColor(DASH_COLORS.white).setFontWeight("bold");payroll.getRange("A6:E6").setBackground(DASH_COLORS.dark).setFontColor(DASH_COLORS.white).setFontWeight("bold");payroll.getRange("G5:J5").setBackground(DASH_COLORS.bronze).setFontColor(DASH_COLORS.white).setFontWeight("bold");}
refreshDashboardData();installDashboardTriggers();SpreadsheetApp.flush();return"Four synchronized JMH dashboards styled and ready.";}
